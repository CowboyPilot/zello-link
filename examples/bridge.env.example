# Zello bridge credentials.
#
#   cp examples/bridge.env.example bridge-local.env
#   chmod 600 bridge-local.env
#   # then fill in the real values below
#
# This file is sourced into the environment; the YAML config refers to these
# as ${ZELLO_AUTH_TOKEN} and ${ZELLO_PASSWORD}. Keeping them here rather than
# in the config means the config itself is safe to share and commit.
#
# .gitignore excludes *.env precisely so the filled-in copy never gets pushed.

# Application credential (JWT) from https://developers.zello.com/
#   Keys -> Add Key -> "Sample Development Token"
#
# Required on the consumer network: a logon carrying only username+password is
# rejected with "not enough params". Development tokens expire after 30 DAYS;
# production should mint them server-side from the issuer + private key, and
# the private key must never live on the bridge host.
ZELLO_AUTH_TOKEN=paste-your-development-token-here

# Password for the Zello ACCOUNT named in zello.username.
# This is NOT a channel password -- the Channel API has no field for one, and
# a password-protected channel cannot be joined at all. Use a moderated
# channel (Zelect+) to control membership instead.
ZELLO_PASSWORD=your-zello-account-password

# Zello Work only: uncomment and point zello.server at your network instead.
#ZELLO_NETWORK=your-network-name

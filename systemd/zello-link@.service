[Unit]
Description=Zello Link - %i
Documentation=file:/opt/zello-link/README.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/opt/zello-link/.venv/bin/zello-link --config /etc/zello-link/%i.yaml --validate
ExecStart=/opt/zello-link/.venv/bin/zello-link --config /etc/zello-link/%i.yaml

# Secrets come from an environment file, not the unit or the config literal.
# chmod 600, owned by root:zellolink.
EnvironmentFile=-/etc/zello-link/%i.env

Restart=always
RestartSec=3

User=zellolink
Group=zellolink
# Only the groups actually needed for audio, serial, and HID access.
SupplementaryGroups=audio dialout plugdev

# SIGTERM triggers the ordered shutdown: stop streams, stop audio, unkey PTT,
# close hardware. Give it room to finish rather than being SIGKILLed mid-unkey.
KillSignal=SIGTERM
TimeoutStopSec=15

# Hardening. The bridge needs no privileges beyond its device groups.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# The only paths it writes.
ReadWritePaths=/var/log/zello-link /var/lib/zello-link
StateDirectory=zello-link
LogsDirectory=zello-link

[Install]
WantedBy=multi-user.target
